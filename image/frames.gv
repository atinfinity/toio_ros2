digraph tf_tree {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.5, ranksep=0.45, bgcolor="transparent"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, penwidth=1.2];
  edge  [fontname="Helvetica", fontsize=9, color="#555555", fontcolor="#555555"];

  map            [fillcolor="#fde9c9", color="#c98a2b"];
  odom           [fillcolor="#d6e9fb", color="#3b7dc4"];
  center         [fillcolor="#d6e9fb", color="#3b7dc4"];
  base_footprint [fillcolor="#e3f2e1", color="#4d9a4d"];
  base_link      [fillcolor="#e3f2e1", color="#4d9a4d"];
  led_link       [fillcolor="#e3f2e1", color="#4d9a4d"];
  rear_caster_link        [fillcolor="#e3f2e1", color="#4d9a4d"];
  base_l_drive_wheel_link [fillcolor="#e3f2e1", color="#4d9a4d"];
  base_r_drive_wheel_link [fillcolor="#e3f2e1", color="#4d9a4d"];

  map  -> odom   [label=" toio_ros2_node, 20 Hz\l corrected from the Position ID,\l held while it is missed\l"];
  odom -> center [label=" toio_ros2_node, 20 Hz\l wheel odometry\l"];
  center -> base_footprint [label=" robot_state_publisher (toio_description)\l static\l"];
  center -> led_link       [label=" static\l"];
  base_footprint -> base_link        [label=" static\l"];
  base_footprint -> rear_caster_link [label=" static\l"];
  base_link -> base_l_drive_wheel_link [label=" joint_state_publisher, 10 Hz\l"];
  base_link -> base_r_drive_wheel_link [label=" joint_state_publisher, 10 Hz\l"];

}
